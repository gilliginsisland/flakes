+++ b/openconnect.h
@@ -722,6 +722,21 @@ int openconnect_setup_tun_fd(struct openconnect_info *vpninfo, intptr_t tun_fd);
 /* Caller will provide a file descriptor for the tunnel traffic. */
 int openconnect_setup_tun_fd(struct openconnect_info *vpninfo, int tun_fd);
 #endif
+/* Packet I/O callbacks. Setup copies this table; context and fd must remain
+ * valid until OpenConnect calls release after native packet processing stops. */
+struct openconnect_packet_bridge {
+	void *context;
+	int fd;
+	ssize_t (*read)(void *context, void *data, size_t size);
+	ssize_t (*write)(void *context, const void *data, size_t size);
+	int (*poll)(void *context);
+	int (*release)(void *context);
+};
+#ifndef _WIN32
+/* Takes ownership of the packet bridge on success. */
+int openconnect_setup_packet_bridge(struct openconnect_info *vpninfo,
+				    const struct openconnect_packet_bridge *bridge);
+#endif
 /* Optional call to enable DTLS on the connection. */
 int openconnect_setup_dtls(struct openconnect_info *vpninfo, int dtls_attempt_period);
 
diff --git a/tun.c b/tun.c
index 234f980..c051185 100644
--- a/tun.c
+++ b/tun.c
@@ -464,6 +464,21 @@ int openconnect_setup_tun_fd(struct openconnect_info *vpninfo, int tun_fd)
 	return 0;
 }
 
+int openconnect_setup_packet_bridge(struct openconnect_info *vpninfo,
+				    const struct openconnect_packet_bridge *bridge)
+{
+	int ret;
+
+	if (vpninfo->packet_bridge.context || !bridge || !bridge->context ||
+	    bridge->fd < 0 || !bridge->read || !bridge->write ||
+	    !bridge->poll || !bridge->release)
+		return -EINVAL;
+	ret = openconnect_setup_tun_fd(vpninfo, bridge->fd);
+	if (!ret)
+		vpninfo->packet_bridge = *bridge;
+	return ret;
+}
+
 int openconnect_setup_tun_script(struct openconnect_info *vpninfo,
 				 const char *tun_script)
 {
@@ -505,6 +520,18 @@ int os_read_tun(struct openconnect_info *vpninfo, struct pkt *pkt)
 	int prefix_size = 0;
 	int len;
 
+	if (vpninfo->packet_bridge.context) {
+		len = vpninfo->packet_bridge.read(vpninfo->packet_bridge.context,
+						    pkt->data, pkt->len);
+		if (len < 0) {
+			if (len != -EAGAIN && len != -EWOULDBLOCK)
+				vpninfo->quit_reason = "Packet bridge read failed";
+			return len;
+		}
+		pkt->len = len;
+		return 0;
+	}
+
 #ifdef TUN_HAS_AF_PREFIX
 	if (!vpninfo->script_tun)
 		prefix_size = sizeof(int);
@@ -524,6 +551,16 @@ int os_write_tun(struct openconnect_info *vpninfo, struct pkt *pkt)
 	unsigned char *data = pkt->data;
 	int len = pkt->len;
 
+	if (vpninfo->packet_bridge.context) {
+		int ret = vpninfo->packet_bridge.write(vpninfo->packet_bridge.context,
+						      data, len);
+		if (ret >= 0)
+			return 0;
+		if (ret != -EAGAIN && ret != -EWOULDBLOCK)
+			vpninfo->quit_reason = "Packet bridge write failed";
+		return ret;
+	}
+
 #ifdef TUN_HAS_AF_PREFIX
 	if (!vpninfo->script_tun) {
 		struct ip *iph = (void *)data;
@@ -591,7 +628,7 @@ void os_shutdown_tun(struct openconnect_info *vpninfo)
 	shutdown_vhost(vpninfo);
 #endif
 
-	if (vpninfo->vpnc_script)
+	if (vpninfo->vpnc_script && !vpninfo->packet_bridge.context)
 		close(vpninfo->tun_fd);
 	vpninfo->tun_fd = -1;
 }
