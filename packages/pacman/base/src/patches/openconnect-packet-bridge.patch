@@ -52,7 +52,18 @@ int tun_mainloop(struct openconnect_info *vpninfo, int *timeout, int readable, i
 	struct pkt *this;
 	int work_done = 0;
 
-	if (readable && read_fd_monitored(vpninfo, tun)) {
+#ifndef _WIN32
+	if (vpninfo->packet_bridge.context && readable) {
