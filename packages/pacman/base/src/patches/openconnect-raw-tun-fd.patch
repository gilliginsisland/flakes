--- a/openconnect.h
+++ b/openconnect.h
@@ -722,3 +722,7 @@ int openconnect_setup_tun_fd(struct openconnect_info *vpninfo, intptr_t tun_fd);
 /* Caller will provide a file descriptor for the tunnel traffic. */
 int openconnect_setup_tun_fd(struct openconnect_info *vpninfo, int tun_fd);
+/* Borrow a file descriptor carrying raw IP packets, without a platform prefix.
+   No script is started. The caller owns the descriptor and must keep it open
+   until all native calls have returned, then close it even if setup failed. */
+int openconnect_setup_tun_fd_raw(struct openconnect_info *vpninfo, int tun_fd);
 #endif
diff --git a/tun.c b/tun.c
--- a/tun.c
+++ b/tun.c
@@ -446,3 +446,4 @@ int openconnect_setup_tun_fd(struct openconnect_info *vpninfo, int tun_fd)
 		unmonitor_fd(vpninfo, tun);
 
+	vpninfo->tun_fd_raw = 0;
 	vpninfo->tun_fd = tun_fd;
@@ -465,3 +466,11 @@ int openconnect_setup_tun_fd(struct openconnect_info *vpninfo, int tun_fd)
 }
 
+int openconnect_setup_tun_fd_raw(struct openconnect_info *vpninfo, int tun_fd)
+{
+	int ret = openconnect_setup_tun_fd(vpninfo, tun_fd);
+
+	vpninfo->tun_fd_raw = 1;
+	return ret;
+}
